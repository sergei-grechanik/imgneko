# Ignore uncovered branches/functions in the quickfix coverage report.
#
# Syntax:
# - blank lines and lines beginning with `#` are ignored
# - `path-glob` suppresses every uncovered branch/function/line in matching
#   files
# - `path-glob function-glob` suppresses matching functions in matching files
#
# Examples:
# src/generated/*.c
# src/util/fatal.c die_*
#
# Note that these are different (ignore everything vs ignore only functions):
# src/file.c
# src/file.c *
#
# For line- or branch-level suppressions in source, use nearby comments such as:
# `IMGNEKO_UNCOVERED_OK`
# `IMGNEKO_UNCOVERED_OK_START` / `IMGNEKO_UNCOVERED_OK_END`
# `IMGNEKO_UNCOVERED_OK[2 lines]`

# This probe in test-runner.c is intentionally uncovered so the coverage
# regression can prove that this file suppresses branch/function findings
# without hiding uncovered line findings from the same source.
testing/tools/test-runner.c coverage_ignore_*

# 3rd party code
src/util/klib/*

# Some macro-generated array functions.
src/util/array.h make_*
src/util/array.h copy_*

# We don't care about coverage of the tests themselves.
testing/tests/*

# TODO: src/main.c is currently rudimentary
src/main.c
