#!/bin/sh
# SPDX-License-Identifier: MIT-0

set -eu

usage() {
    cat <<'EOF'
Usage:
  ./configure [OPTIONS] [VAR=VALUE ...]

Options:
  --profile=NAME       Select profile: default, release, debug, asan, dev
  --build-dir=DIR      Build directory (default: build/<profile>)
  --comp-db-mj         Generate compile_commands.json via compiler -MJ output
  --coverage-report    Enable Clang source-based coverage and `make coverage`
  --depfiles           Generate compiler depfiles for `make depfile`
  --test-jobs=JOBS     Default number of parallel test jobs for test-runner
  --prefix=PATH        Install prefix
  --cc=CC              C compiler
  --llvm-profdata=TOOL llvm-profdata executable for coverage reports
  --llvm-cov=TOOL      llvm-cov executable for coverage reports
  --cppflags=FLAGS     Preprocessor flags
  --cflags=FLAGS       C compiler flags
  --ldflags=FLAGS      Linker flags
  --ldlibs=LIBS        Additional libraries appended after dependency libraries
  --zlib-cppflags=FLAGS
                       Override automatically detected zlib preprocessor flags
  --zlib-ldlibs=LIBS   Override automatically detected zlib link libraries
  --feature-x=ON|OFF   Example feature toggle
  --force              Overwrite an existing different config
  --help               Show this help

You can also use make-style assignments:
  ./configure PROFILE=debug BUILD_DIR=build/debug CC=clang

Examples:
  ./configure --profile=release
  ./configure PROFILE=debug BUILD_DIR=build/debug
  ./configure --profile=asan --cc=clang
  ./configure --profile=dev
EOF
}

die() {
    printf '%s\n' "error: $*" >&2
    exit 1
}

INITIAL_CWD=$(pwd)

require_no_whitespace() {
    var_name=$1
    var_value=$2

    case $var_value in
        *[[:space:]]*)
            die "$var_name must not contain whitespace ($var_value)"
            ;;
    esac
}

# Escape a value for a make variable assignment.
# We escape:
#   $  -> $$   so make keeps it literal
#   #  -> \#   so it does not start a make comment
escape_make() {
    printf '%s' "$1" | sed 's/\$/$$/g; s/#/\\#/g'
}

# Quote one shell word so it can be replayed safely in configure.cmd.
shell_quote() {
    case $1 in
        '')
            printf '%s' "''"
            ;;
        *[!A-Za-z0-9_./:=,+-]*)
            printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
            ;;
        *)
            printf '%s' "$1"
            ;;
    esac
}

# Join words into one shell command line using shell_quote() for each word.
join_shell_words() {
    first=1
    for word do
        quoted_word=$(shell_quote "$word")
        if [ "$first" -eq 1 ]; then
            printf '%s' "$quoted_word"
            first=0
        else
            printf ' %s' "$quoted_word"
        fi
    done
}

# Like join_shell_words(), but drop any --force flag so stale-config hints can
# append it exactly once when they tell the user how to rerun configure.
join_shell_words_without_force() {
    first=1
    for word do
        if [ "$word" = "--force" ]; then
            continue
        fi

        quoted_word=$(shell_quote "$word")
        if [ "$first" -eq 1 ]; then
            printf '%s' "$quoted_word"
            first=0
        else
            printf ' %s' "$quoted_word"
        fi
    done
}

# Rewrite paths under the caller's original working directory as ./... in
# user-facing output, while leaving unrelated absolute paths unchanged.
pretty_path() {
    path=$1

    case $path in
        "$INITIAL_CWD")
            printf '%s' .
            ;;
        "$INITIAL_CWD"/*)
            printf '.%s' "${path#$INITIAL_CWD}"
            ;;
        *)
            printf '%s' "$path"
            ;;
    esac
}

# Parse and execute a compiler probe without exposing the configure shell to
# shell syntax in configured commands or flags. The command file starts with a
# best-effort representation so parsing failures still have useful context;
# after successful parsing it contains the exact argv passed to the compiler.
# The compiler also receives the configured variables in its environment, as
# compiler launchers may inspect them.
#
# `command_expr`
#     Shell expression that builds the complete compiler argv with `set --`.
# `command_file`
#     Output file receiving the best available command representation.
# `stderr_file`
#     Output file receiving parsing and compiler diagnostics.
# `environment_names`
#     Shell word list naming the variables exported to the compiler.
run_compiler_probe() (
    command_expr=$1
    command_file=$2
    stderr_file=$3
    environment_names=$4
    exec 2>"$stderr_file"

    # Keep expansion deterministic and contain any `eval` side effects in this
    # disposable subshell.
    unset IFS
    set +f
    command_text=${command_expr#'set -- '}
    printf '%s' "$command_text" >"$command_file"

    # The names are internal constants supplied by the individual probes.
    export $environment_names

    eval "$command_expr" || exit $?
    join_shell_words "$@" >"$command_file" || exit $?
    exec "$@"
)

# Report a failed compiler probe and terminate configuration.
#
# `message`
#     Explanation of the capability required by the selected configuration.
# `command_file`
#     File containing the best available form of the compiler command.
# `stderr_file`
#     File containing the complete diagnostic output from the compiler.
# `probe_dir`
#     Temporary probe directory to remove before exiting.
report_probe_failure() {
    message=$1
    command_file=$2
    stderr_file=$3
    probe_dir=$4

    printf '%s\n' "error: $message" >&2
    printf '%s' '  command: ' >&2
    cat "$command_file" >&2
    printf '\n' >&2
    if [ -s "$stderr_file" ]; then
        printf '%s\n' '  output:' >&2
        sed 's/^/    /' "$stderr_file" >&2
    fi
    rm -rf "$probe_dir"
    exit 1
}

# A function to test if the compiler supports -MJ for generating
# compile_commands.json.
probe_comp_db_mj() {
    probe_dir="$(mktemp -d)"
    probe_src="$probe_dir/probe.c"
    probe_obj="$probe_dir/probe.o"
    probe_json="$probe_dir/probe.json"
    probe_command_file="$probe_dir/command"
    probe_err="$probe_dir/stderr"

    printf '%s\n' 'int main(void) { return 0; }' >"$probe_src"

    PROBE_SRC=$probe_src
    PROBE_OBJ=$probe_obj
    PROBE_JSON=$probe_json
    if ! run_compiler_probe \
        "set -- $CC $CPPFLAGS $CFLAGS -MJ $(shell_quote "$PROBE_JSON") -c $(shell_quote "$PROBE_SRC") -o $(shell_quote "$PROBE_OBJ")" \
        "$probe_command_file" "$probe_err" \
        'CC CPPFLAGS CFLAGS PROBE_SRC PROBE_OBJ PROBE_JSON' > /dev/null; then
        report_probe_failure \
            '--comp-db-mj requires a compiler that accepts -MJ' \
            "$probe_command_file" "$probe_err" "$probe_dir"
    fi

    rm -rf "$probe_dir"
}

# A function to test if the compiler supports generating depfiles.
probe_depfiles() {
    probe_dir="$(mktemp -d)"
    probe_src="$probe_dir/probe.c"
    probe_obj="$probe_dir/probe.o"
    probe_dep="$probe_dir/probe.d"
    probe_command_file="$probe_dir/command"
    probe_err="$probe_dir/stderr"

    printf '%s\n' 'int main(void) { return 0; }' >"$probe_src"

    PROBE_SRC=$probe_src
    PROBE_OBJ=$probe_obj
    PROBE_DEP=$probe_dep
    if ! run_compiler_probe \
        "set -- $CC $CPPFLAGS $CFLAGS -MMD -MP -MT probe-target -MF $(shell_quote "$PROBE_DEP") -c $(shell_quote "$PROBE_SRC") -o $(shell_quote "$PROBE_OBJ")" \
        "$probe_command_file" "$probe_err" \
        'CC CPPFLAGS CFLAGS PROBE_SRC PROBE_OBJ PROBE_DEP' > /dev/null; then
        report_probe_failure \
            '--depfiles requires a compiler that accepts -MMD -MP -MT -MF' \
            "$probe_command_file" "$probe_err" "$probe_dir"
    fi

    rm -rf "$probe_dir"
}

# Detect a reasonable default for parallel test execution. Prefer the online
# CPU count when the host exposes one, and fall back to 4 when it does not.
detect_default_test_jobs() {
    detected_jobs=

    if command -v getconf >/dev/null 2>&1; then
        detected_jobs=$(getconf _NPROCESSORS_ONLN 2>/dev/null || true)
    fi

    if [ -z "$detected_jobs" ] && command -v nproc >/dev/null 2>&1; then
        detected_jobs=$(nproc 2>/dev/null || true)
    fi

    case $detected_jobs in
        ''|*[!0-9]*)
            detected_jobs=4
            ;;
        *)
            if [ "$detected_jobs" -le 0 ] 2>/dev/null; then
                detected_jobs=4
            fi
            ;;
    esac

    printf '%s' "$detected_jobs"
}

# Try to infer a matching LLVM tool major version from the configured compiler.
detect_clang_major_version() {
    cc_version=$(
        CC=$CC sh -ec 'eval "set -- $CC"; "$1" --version' 2>/dev/null |
        sed -n 's/.*clang version \([0-9][0-9]*\).*/\1/p' | sed -n '1p'
    )

    if [ -n "$cc_version" ]; then
        printf '%s' "$cc_version"
    fi
}

# Resolve an llvm-* tool path, preferring a versioned binary that matches the
# configured Clang major version when one is available.
resolve_llvm_tool() {
    tool_name=$1
    configured_tool=$2
    clang_major=$(detect_clang_major_version)

    if [ -n "$configured_tool" ]; then
        if ! command -v "$configured_tool" >/dev/null 2>&1; then
            die "$tool_name executable not found: $configured_tool"
        fi
        printf '%s' "$configured_tool"
        return
    fi

    if [ -n "$clang_major" ] &&
       command -v "$tool_name-$clang_major" >/dev/null 2>&1; then
        printf '%s' "$tool_name-$clang_major"
        return
    fi

    if command -v "$tool_name" >/dev/null 2>&1; then
        printf '%s' "$tool_name"
        return
    fi

    if [ -n "$clang_major" ]; then
        die "--coverage-report requires $tool_name-$clang_major (or $tool_name) in PATH"
    fi
    die "--coverage-report requires $tool_name in PATH"
}

# Test whether the current compiler and linker support Clang source-based
# coverage, and resolve the llvm-profdata/llvm-cov tools required to report it.
probe_coverage() {
    probe_dir="$(mktemp -d)"
    probe_src="$probe_dir/probe.c"
    probe_bin="$probe_dir/probe.bin"
    probe_command_file="$probe_dir/command"
    probe_err="$probe_dir/stderr"

    printf '%s\n' 'int main(void) { return 0; }' >"$probe_src"

    PROBE_SRC=$probe_src
    PROBE_BIN=$probe_bin
    if ! run_compiler_probe \
        "set -- $CC $CPPFLAGS $CFLAGS -fprofile-instr-generate -fcoverage-mapping $(shell_quote "$PROBE_SRC") -o $(shell_quote "$PROBE_BIN") $LDFLAGS -fprofile-instr-generate $LDLIBS" \
        "$probe_command_file" "$probe_err" \
        'CC CPPFLAGS CFLAGS LDFLAGS LDLIBS PROBE_SRC PROBE_BIN' \
        > /dev/null; then
        report_probe_failure \
            '--coverage-report requires a Clang-compatible compiler and linker that accept -fprofile-instr-generate -fcoverage-mapping' \
            "$probe_command_file" "$probe_err" "$probe_dir"
    fi

    if ! command -v python3 >/dev/null 2>&1; then
        rm -rf "$probe_dir"
        die "--coverage-report requires python3 in PATH"
    fi

    LLVM_PROFDATA=$(resolve_llvm_tool llvm-profdata "$LLVM_PROFDATA")
    LLVM_COV=$(resolve_llvm_tool llvm-cov "$LLVM_COV")

    rm -rf "$probe_dir"
}

# Verify that the resolved compiler and linker flags provide a usable zlib.
probe_zlib() {
    probe_dir="$(mktemp -d)"
    probe_src="$probe_dir/probe.c"
    probe_bin="$probe_dir/probe.bin"
    probe_command_file="$probe_dir/command"
    probe_err="$probe_dir/stderr"

    printf '%s\n' '#include <zlib.h>' \
        'int main(void) { return zlibVersion() == Z_NULL; }' >"$probe_src"

    PROBE_SRC=$probe_src
    PROBE_BIN=$probe_bin

    printf '%s' 'Checking whether the resolved zlib flags work... '
    if ! run_compiler_probe \
        "set -- $CC $CPPFLAGS $ZLIB_CPPFLAGS $CFLAGS $(shell_quote "$PROBE_SRC") -o $(shell_quote "$PROBE_BIN") $LDFLAGS $ZLIB_LDLIBS $LDLIBS" \
        "$probe_command_file" "$probe_err" \
        'CC CPPFLAGS ZLIB_CPPFLAGS CFLAGS LDFLAGS ZLIB_LDLIBS LDLIBS PROBE_SRC PROBE_BIN' \
        > /dev/null; then
        printf '%s\n' no
        report_probe_failure 'resolved zlib flags do not compile and link' \
            "$probe_command_file" "$probe_err" "$probe_dir"
    fi

    printf '%s\n' yes
    rm -rf "$probe_dir"
}

# Resolve each zlib flag group that the caller did not provide. Prefer
# pkg-config, with conventional compiler defaults and -lz as fallbacks.
resolve_zlib_flags() {
    detected_cppflags=
    detected_ldlibs=

    if [ "$ZLIB_CPPFLAGS_SET" -eq 1 ] && [ "$ZLIB_LDLIBS_SET" -eq 1 ]; then
        printf '%s\n' \
            'Using caller-provided zlib flags.'
    else
        if [ "$ZLIB_CPPFLAGS_SET" -eq 1 ]; then
            printf '%s\n' \
                'Keeping caller-provided ZLIB_CPPFLAGS; resolving ZLIB_LDLIBS.'
        elif [ "$ZLIB_LDLIBS_SET" -eq 1 ]; then
            printf '%s\n' \
                'Keeping caller-provided ZLIB_LDLIBS; resolving ZLIB_CPPFLAGS.'
        else
            printf '%s\n' 'Resolving ZLIB_CPPFLAGS and ZLIB_LDLIBS.'
        fi

        printf 'Checking for zlib flags with %s... ' "$PKG_CONFIG"
        if command -v "$PKG_CONFIG" >/dev/null 2>&1 &&
               "$PKG_CONFIG" --exists zlib >/dev/null 2>&1 &&
               detected_cppflags=$("$PKG_CONFIG" --cflags zlib 2>/dev/null) &&
               detected_ldlibs=$("$PKG_CONFIG" --libs zlib 2>/dev/null);
        then
            detected_cppflags=$(printf '%s' "$detected_cppflags" | sed 's/[[:space:]]*$//')
            detected_ldlibs=$(printf '%s' "$detected_ldlibs" | sed 's/[[:space:]]*$//')
        fi

        if [ -n "$detected_ldlibs" ]; then
            printf '%s\n' found
        else
            printf '%s\n' unavailable
            detected_cppflags=
            detected_ldlibs=-lz
            printf '%s\n' \
                'Using fallback values for missing zlib flags: empty CPPFLAGS and LDLIBS=-lz.'
        fi

        if [ "$ZLIB_CPPFLAGS_SET" -eq 0 ]; then
            ZLIB_CPPFLAGS=$detected_cppflags
        fi
        if [ "$ZLIB_LDLIBS_SET" -eq 0 ]; then
            ZLIB_LDLIBS=$detected_ldlibs
        fi
    fi

    printf '%s\n' 'Resolved zlib flags:'
    printf '%s\n' "  ZLIB_CPPFLAGS=$ZLIB_CPPFLAGS"
    printf '%s\n' "  ZLIB_LDLIBS=$ZLIB_LDLIBS"
}

# The caller may explicitly provide an empty dependency flag group. Track
# presence separately from value so detection fills only genuinely missing
# groups.
ZLIB_CPPFLAGS_SET=0
if [ "${ZLIB_CPPFLAGS+x}" = x ]; then
    ZLIB_CPPFLAGS_SET=1
else
    ZLIB_CPPFLAGS=
fi

ZLIB_LDLIBS_SET=0
if [ "${ZLIB_LDLIBS+x}" = x ]; then
    ZLIB_LDLIBS_SET=1
else
    ZLIB_LDLIBS=
fi

# Absolute repository root, assuming this script lives in the project root.
ROOT_DIR=$(CDPATH= cd "$(dirname "$0")" && pwd)
require_no_whitespace ROOT_DIR "$ROOT_DIR"
ORIGINAL_CONFIGURE_CMD=$(join_shell_words_without_force "$ROOT_DIR/configure" "$@")

FORCE=0

# Track which command-line options were explicitly provided.
ARG_PROFILE_SET=0
ARG_BUILD_DIR_SET=0
ARG_PREFIX_SET=0
ARG_CC_SET=0
ARG_CPPFLAGS_SET=0
ARG_CFLAGS_SET=0
ARG_LDFLAGS_SET=0
ARG_LDLIBS_SET=0
ARG_ZLIB_CPPFLAGS_SET=0
ARG_ZLIB_LDLIBS_SET=0
ARG_LLVM_PROFDATA_SET=0
ARG_LLVM_COV_SET=0
ARG_FEATURE_X_SET=0
ARG_COMP_DB_MJ_SET=0
ARG_COVERAGE_REPORT_SET=0
ARG_DEPFILES_SET=0
ARG_TEST_JOBS_SET=0

ARG_PROFILE=
ARG_BUILD_DIR=
ARG_PREFIX=
ARG_CC=
ARG_CPPFLAGS=
ARG_CFLAGS=
ARG_LDFLAGS=
ARG_LDLIBS=
ARG_ZLIB_CPPFLAGS=
ARG_ZLIB_LDLIBS=
ARG_LLVM_PROFDATA=
ARG_LLVM_COV=
ARG_FEATURE_X=
ARG_COMP_DB_MJ=
ARG_COVERAGE_REPORT=
ARG_DEPFILES=
ARG_TEST_JOBS=

validate_positive_integer() {
    var_name=$1
    value=$2

    case $value in
        ''|*[!0-9]*)
            die "$var_name must be a positive integer (got: $value)"
            ;;
    esac

    if [ "$value" -le 0 ] 2>/dev/null; then
        die "$var_name must be a positive integer (got: $value)"
    fi
}

while [ "$#" -gt 0 ]; do
    case $1 in
        --help|-h)
            usage
            exit 0
            ;;
        --force)
            FORCE=1
            ;;
        --profile=*)
            ARG_PROFILE_SET=1
            ARG_PROFILE=${1#*=}
            ;;
        --build-dir=*)
            ARG_BUILD_DIR_SET=1
            ARG_BUILD_DIR=${1#*=}
            ;;
        --comp-db-mj)
            ARG_COMP_DB_MJ_SET=1
            ARG_COMP_DB_MJ=ON
            ;;
        --coverage-report)
            ARG_COVERAGE_REPORT_SET=1
            ARG_COVERAGE_REPORT=ON
            ;;
        --depfiles)
            ARG_DEPFILES_SET=1
            ARG_DEPFILES=ON
            ;;
        --test-jobs=*)
            ARG_TEST_JOBS_SET=1
            ARG_TEST_JOBS=${1#*=}
            ;;
        --prefix=*)
            ARG_PREFIX_SET=1
            ARG_PREFIX=${1#*=}
            ;;
        --cc=*)
            ARG_CC_SET=1
            ARG_CC=${1#*=}
            ;;
        --llvm-profdata=*)
            ARG_LLVM_PROFDATA_SET=1
            ARG_LLVM_PROFDATA=${1#*=}
            ;;
        --llvm-cov=*)
            ARG_LLVM_COV_SET=1
            ARG_LLVM_COV=${1#*=}
            ;;
        --cppflags=*)
            ARG_CPPFLAGS_SET=1
            ARG_CPPFLAGS=${1#*=}
            ;;
        --cflags=*)
            ARG_CFLAGS_SET=1
            ARG_CFLAGS=${1#*=}
            ;;
        --ldflags=*)
            ARG_LDFLAGS_SET=1
            ARG_LDFLAGS=${1#*=}
            ;;
        --ldlibs=*)
            ARG_LDLIBS_SET=1
            ARG_LDLIBS=${1#*=}
            ;;
        --zlib-cppflags=*)
            ARG_ZLIB_CPPFLAGS_SET=1
            ARG_ZLIB_CPPFLAGS=${1#*=}
            ;;
        --zlib-ldlibs=*)
            ARG_ZLIB_LDLIBS_SET=1
            ARG_ZLIB_LDLIBS=${1#*=}
            ;;
        --feature-x=*)
            ARG_FEATURE_X_SET=1
            ARG_FEATURE_X=${1#*=}
            ;;
        PROFILE=*)
            ARG_PROFILE_SET=1
            ARG_PROFILE=${1#*=}
            ;;
        BUILD_DIR=*)
            ARG_BUILD_DIR_SET=1
            ARG_BUILD_DIR=${1#*=}
            ;;
        PREFIX=*)
            ARG_PREFIX_SET=1
            ARG_PREFIX=${1#*=}
            ;;
        CC=*)
            ARG_CC_SET=1
            ARG_CC=${1#*=}
            ;;
        CPPFLAGS=*)
            ARG_CPPFLAGS_SET=1
            ARG_CPPFLAGS=${1#*=}
            ;;
        CFLAGS=*)
            ARG_CFLAGS_SET=1
            ARG_CFLAGS=${1#*=}
            ;;
        LDFLAGS=*)
            ARG_LDFLAGS_SET=1
            ARG_LDFLAGS=${1#*=}
            ;;
        LDLIBS=*)
            ARG_LDLIBS_SET=1
            ARG_LDLIBS=${1#*=}
            ;;
        ZLIB_CPPFLAGS=*)
            ARG_ZLIB_CPPFLAGS_SET=1
            ARG_ZLIB_CPPFLAGS=${1#*=}
            ;;
        ZLIB_LDLIBS=*)
            ARG_ZLIB_LDLIBS_SET=1
            ARG_ZLIB_LDLIBS=${1#*=}
            ;;
        LLVM_PROFDATA=*)
            ARG_LLVM_PROFDATA_SET=1
            ARG_LLVM_PROFDATA=${1#*=}
            ;;
        LLVM_COV=*)
            ARG_LLVM_COV_SET=1
            ARG_LLVM_COV=${1#*=}
            ;;
        FEATURE_X=*)
            ARG_FEATURE_X_SET=1
            ARG_FEATURE_X=${1#*=}
            ;;
        COMP_DB_MJ=*)
            ARG_COMP_DB_MJ_SET=1
            ARG_COMP_DB_MJ=${1#*=}
            ;;
        COVERAGE_REPORT=*)
            ARG_COVERAGE_REPORT_SET=1
            ARG_COVERAGE_REPORT=${1#*=}
            ;;
        DEPFILES=*)
            ARG_DEPFILES_SET=1
            ARG_DEPFILES=${1#*=}
            ;;
        TEST_JOBS=*)
            ARG_TEST_JOBS_SET=1
            ARG_TEST_JOBS=${1#*=}
            ;;
        --)
            shift
            break
            ;;
        *)
            die "unknown option or assignment: $1"
            ;;
    esac
    shift
done

[ "$#" -eq 0 ] || die "unexpected positional arguments"

# Command-line options > Environment variables > Profile defaults
: "${PROFILE:=default}"
DEFAULT_TEST_JOBS=$(detect_default_test_jobs)

if [ "$ARG_PROFILE_SET" -eq 1 ]; then
    PROFILE=$ARG_PROFILE
fi

case $PROFILE in
    default)
        : "${PREFIX:=/usr/local}"
        : "${CC:=cc}"
        : "${CPPFLAGS:=}"
        : "${CFLAGS:=--std=c99 -O2 -g -Wall -Wextra -Wpedantic}"
        : "${LDFLAGS:=}"
        : "${LDLIBS:=}"
        : "${LLVM_PROFDATA:=}"
        : "${LLVM_COV:=}"
        : "${FEATURE_X:=OFF}"
        : "${COMP_DB_MJ:=OFF}"
        : "${COVERAGE_REPORT:=OFF}"
        : "${DEPFILES:=OFF}"
        : "${TEST_JOBS:=$DEFAULT_TEST_JOBS}"
        ;;
    release)
        : "${PREFIX:=/usr/local}"
        : "${CC:=cc}"
        : "${CPPFLAGS:=}"
        : "${CFLAGS:=--std=c99 -O2 -DNDEBUG -Wall -Wextra -Wpedantic}"
        : "${LDFLAGS:=}"
        : "${LDLIBS:=}"
        : "${LLVM_PROFDATA:=}"
        : "${LLVM_COV:=}"
        : "${FEATURE_X:=OFF}"
        : "${COMP_DB_MJ:=OFF}"
        : "${COVERAGE_REPORT:=OFF}"
        : "${DEPFILES:=OFF}"
        : "${TEST_JOBS:=$DEFAULT_TEST_JOBS}"
        ;;
    debug)
        : "${PREFIX:=/usr/local}"
        : "${CC:=cc}"
        : "${CPPFLAGS:=}"
        : "${CFLAGS:=--std=c99 -O0 -g3 -Wall -Wextra -Wpedantic}"
        : "${LDFLAGS:=}"
        : "${LDLIBS:=}"
        : "${LLVM_PROFDATA:=}"
        : "${LLVM_COV:=}"
        : "${FEATURE_X:=OFF}"
        : "${COMP_DB_MJ:=OFF}"
        : "${COVERAGE_REPORT:=OFF}"
        : "${DEPFILES:=OFF}"
        : "${TEST_JOBS:=$DEFAULT_TEST_JOBS}"
        ;;
    asan)
        : "${PREFIX:=/usr/local}"
        : "${CC:=clang}"
        : "${CPPFLAGS:=}"
        : "${CFLAGS:=--std=c99 -O0 -g3 -Wall -Wextra -Wpedantic -fsanitize=address,undefined}"
        : "${LDFLAGS:=-fsanitize=address,undefined}"
        : "${LDLIBS:=}"
        : "${LLVM_PROFDATA:=}"
        : "${LLVM_COV:=}"
        : "${FEATURE_X:=OFF}"
        : "${COMP_DB_MJ:=OFF}"
        : "${COVERAGE_REPORT:=OFF}"
        : "${DEPFILES:=OFF}"
        : "${TEST_JOBS:=$DEFAULT_TEST_JOBS}"
        ;;
    dev)
        : "${PREFIX:=/usr/local}"
        : "${CC:=clang}"
        : "${CPPFLAGS:=}"
        : "${CFLAGS:=--std=c99 -O0 -g3 -Wall -Wextra -Wpedantic -fsanitize=address,undefined}"
        : "${LDFLAGS:=-fsanitize=address,undefined}"
        : "${LDLIBS:=}"
        : "${LLVM_PROFDATA:=}"
        : "${LLVM_COV:=}"
        : "${FEATURE_X:=OFF}"
        : "${COMP_DB_MJ:=ON}"
        : "${COVERAGE_REPORT:=ON}"
        : "${DEPFILES:=ON}"
        : "${TEST_JOBS:=$DEFAULT_TEST_JOBS}"
        ;;
    *)
        die "unknown profile: $PROFILE"
        ;;
esac

# Command-line options/assignments override both environment and profile defaults.
if [ "$ARG_PREFIX_SET" -eq 1 ]; then PREFIX=$ARG_PREFIX; fi
if [ "$ARG_CC_SET" -eq 1 ]; then CC=$ARG_CC; fi
if [ "$ARG_LLVM_PROFDATA_SET" -eq 1 ]; then LLVM_PROFDATA=$ARG_LLVM_PROFDATA; fi
if [ "$ARG_LLVM_COV_SET" -eq 1 ]; then LLVM_COV=$ARG_LLVM_COV; fi
if [ "$ARG_CPPFLAGS_SET" -eq 1 ]; then CPPFLAGS=$ARG_CPPFLAGS; fi
if [ "$ARG_CFLAGS_SET" -eq 1 ]; then CFLAGS=$ARG_CFLAGS; fi
if [ "$ARG_LDFLAGS_SET" -eq 1 ]; then LDFLAGS=$ARG_LDFLAGS; fi
if [ "$ARG_LDLIBS_SET" -eq 1 ]; then LDLIBS=$ARG_LDLIBS; fi
if [ "$ARG_ZLIB_CPPFLAGS_SET" -eq 1 ]; then
    ZLIB_CPPFLAGS=$ARG_ZLIB_CPPFLAGS
    ZLIB_CPPFLAGS_SET=1
fi
if [ "$ARG_ZLIB_LDLIBS_SET" -eq 1 ]; then
    ZLIB_LDLIBS=$ARG_ZLIB_LDLIBS
    ZLIB_LDLIBS_SET=1
fi
if [ "$ARG_FEATURE_X_SET" -eq 1 ]; then FEATURE_X=$ARG_FEATURE_X; fi
if [ "$ARG_COMP_DB_MJ_SET" -eq 1 ]; then COMP_DB_MJ=$ARG_COMP_DB_MJ; fi
if [ "$ARG_COVERAGE_REPORT_SET" -eq 1 ]; then COVERAGE_REPORT=$ARG_COVERAGE_REPORT; fi
if [ "$ARG_DEPFILES_SET" -eq 1 ]; then DEPFILES=$ARG_DEPFILES; fi
if [ "$ARG_TEST_JOBS_SET" -eq 1 ]; then TEST_JOBS=$ARG_TEST_JOBS; fi

case $FEATURE_X in
    ON|OFF) ;;
    *)
        die "FEATURE_X must be ON or OFF (got: $FEATURE_X)"
        ;;
esac

case $COMP_DB_MJ in
    ON|OFF) ;;
    *)
        die "COMP_DB_MJ must be ON or OFF (got: $COMP_DB_MJ)"
        ;;
esac

case $COVERAGE_REPORT in
    ON|OFF) ;;
    *)
        die "COVERAGE_REPORT must be ON or OFF (got: $COVERAGE_REPORT)"
        ;;
esac

case $DEPFILES in
    ON|OFF) ;;
    *)
        die "DEPFILES must be ON or OFF (got: $DEPFILES)"
        ;;
esac

validate_positive_integer TEST_JOBS "$TEST_JOBS"

: "${PKG_CONFIG:=pkg-config}"
resolve_zlib_flags

if [ "$COMP_DB_MJ" = "ON" ]; then
    probe_comp_db_mj
fi

if [ "$COVERAGE_REPORT" = "ON" ]; then
    probe_coverage
fi

if [ "$DEPFILES" = "ON" ]; then
    probe_depfiles
fi

probe_zlib

# Create the build directory if it does not exist.
if [ "$ARG_BUILD_DIR_SET" -eq 1 ]; then
    BUILD_DIR=$ARG_BUILD_DIR
else
    : "${BUILD_DIR:=build/$PROFILE}"
fi

require_no_whitespace BUILD_DIR "$BUILD_DIR"

mkdir -p "$BUILD_DIR"

# Find the absolute path of the build directory.
BUILD_DIR=$(CDPATH= cd "$BUILD_DIR" && pwd)

if [ "$BUILD_DIR" = "$ROOT_DIR" ]; then
    die "BUILD_DIR must not resolve to ROOT_DIR ($ROOT_DIR)"
fi

CONFIG_MK=$BUILD_DIR/config.mk
WRAPPER_MK=$BUILD_DIR/Makefile
CONFIGURE_CMD=$BUILD_DIR/configure.cmd

tmp_config=$CONFIG_MK.tmp
tmp_wrapper=$WRAPPER_MK.tmp
tmp_configure_cmd=$CONFIGURE_CMD.tmp

cat >"$tmp_config" <<EOF
# Generated by ./configure. Re-run configure to change these settings.

override ROOT_DIR = $(escape_make "$ROOT_DIR")
override PROFILE = $(escape_make "$PROFILE")

override PREFIX = $(escape_make "$PREFIX")
override CC = $(escape_make "$CC")
override CPPFLAGS = $(escape_make "$CPPFLAGS")
override CFLAGS = $(escape_make "$CFLAGS")
override LDFLAGS = $(escape_make "$LDFLAGS")
override LDLIBS = $(escape_make "$LDLIBS")
override ZLIB_CPPFLAGS = $(escape_make "$ZLIB_CPPFLAGS")
override ZLIB_LDLIBS = $(escape_make "$ZLIB_LDLIBS")
override FEATURE_X = $(escape_make "$FEATURE_X")
override COMP_DB_MJ = $(escape_make "$COMP_DB_MJ")
override DEPFILES = $(escape_make "$DEPFILES")
override TEST_JOBS = $(escape_make "$TEST_JOBS")
override COVERAGE_REPORT = $(escape_make "$COVERAGE_REPORT")
override LLVM_PROFDATA = $(escape_make "$LLVM_PROFDATA")
override LLVM_COV = $(escape_make "$LLVM_COV")
EOF

printf '%s\n' "$ORIGINAL_CONFIGURE_CMD" >"$tmp_configure_cmd"

if [ -f "$CONFIG_MK" ] && ! cmp -s "$CONFIG_MK" "$tmp_config"; then
    if [ "$FORCE" -ne 1 ]; then
        rm -f "$tmp_config" "$tmp_configure_cmd"
        die "$CONFIG_MK already exists and differs; rerun with --force to replace it"
    fi
fi

mv "$tmp_config" "$CONFIG_MK"

# Small convenience wrapper. It forwards common targets back to the real
# top-level Makefile while fixing BUILD_DIR to this directory.
cat >"$tmp_wrapper" <<EOF
# Generated by ./configure. Convenience wrapper for this build directory.
ROOT_DIR := $ROOT_DIR
BUILD_DIR := $BUILD_DIR

.DEFAULT_GOAL := all
Makefile: ;
.PHONY: FORCE
%: FORCE
	+\$(MAKE) -C "\$(ROOT_DIR)" BUILD_DIR="\$(BUILD_DIR)" \$@
FORCE:
EOF

mv "$tmp_wrapper" "$WRAPPER_MK"
mv "$tmp_configure_cmd" "$CONFIGURE_CMD"

printf '%s\n' "Configured $(pretty_path "$BUILD_DIR")"
printf '%s\n' "  PROFILE=$PROFILE"
printf '%s\n' "  PREFIX=$PREFIX"
printf '%s\n' "  CC=$CC"
printf '%s\n' "  CPPFLAGS=$CPPFLAGS"
printf '%s\n' "  CFLAGS=$CFLAGS"
printf '%s\n' "  LDFLAGS=$LDFLAGS"
printf '%s\n' "  LDLIBS=$LDLIBS"
printf '%s\n' "  ZLIB_CPPFLAGS=$ZLIB_CPPFLAGS"
printf '%s\n' "  ZLIB_LDLIBS=$ZLIB_LDLIBS"
printf '%s\n' "  FEATURE_X=$FEATURE_X"
printf '%s\n' "  COMP_DB_MJ=$COMP_DB_MJ"
printf '%s\n' "  DEPFILES=$DEPFILES"
printf '%s\n' "  TEST_JOBS=$TEST_JOBS"
printf '%s\n' "  COVERAGE_REPORT=$COVERAGE_REPORT"
printf '%s\n' "  LLVM_PROFDATA=$LLVM_PROFDATA"
printf '%s\n' "  LLVM_COV=$LLVM_COV"
printf '%s\n' ""
printf '%s\n' "Wrote:"
printf '%s\n' "  $(pretty_path "$CONFIG_MK")"
printf '%s\n' "  $(pretty_path "$WRAPPER_MK")"
printf '%s\n' "  $(pretty_path "$CONFIGURE_CMD")"
printf '%s\n' ""
printf '%s\n' "To build, run make BUILD_DIR=$(pretty_path "$BUILD_DIR")"
